# Leave empty to use the existing local SQLite database.
DATABASE_URL=

# For hosted PostgreSQL, put the actual URL in .env.local (ignored by Git),
# or configure it as a server-only Vercel environment variable.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional SQLite file location; ignored when DATABASE_URL is configured.
# RELIEFLINK_DB=data/relieflink.db
